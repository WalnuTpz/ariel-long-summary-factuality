# Main 600-sample retrieval comparison and ARIEL ablation configuration for GPU runs.

PYTHON=.venv/bin/python
RUN_NAME=main_600_compare_gpu
RUN_DIR=data/results/main_600_compare_gpu

DOCUMENTS=data/processed/documents_main_600.jsonl
SUMMARIES=data/processed/generated_summaries.qwen2p5_1p5b.main_600.jsonl
SUMMARY_FIELD=generated_summary

METHODS="bm25 embedding hybrid ariel ariel_no_coverage ariel_no_expansion ariel_no_risk_weighting"

TOP_K=3
CHUNK_TYPE=paragraph
CHUNK_MAX_TOKENS=256
HYBRID_ALPHA=0.5

HF_LOCAL_FILES_ONLY=0

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cuda
EMBEDDING_LOCAL_FILES_ONLY=0

NLI_MODEL=facebook/bart-large-mnli
NLI_DEVICE=cuda
NLI_MAX_LENGTH=1024
NLI_AGGREGATION=per_chunk
NLI_ENTAILMENT_THRESHOLD=0.5
NLI_CONTRADICTION_THRESHOLD=0.5
NLI_LOCAL_FILES_ONLY=0

EXPORT_CASES=1
