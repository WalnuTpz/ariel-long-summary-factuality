# Main 600-sample end-to-end pipeline configuration.
# Before running, make sure DOCUMENTS and SUMMARIES point to existing JSONL files.

PYTHON=.venv/bin/python
RUN_NAME=main_600_ariel
RUN_DIR=data/results/main_600_ariel

DOCUMENTS=data/processed/documents_main_600.jsonl
SUMMARIES=data/processed/generated_summaries.qwen2p5_1p5b.main_600.jsonl
SUMMARY_FIELD=generated_summary

RETRIEVAL_METHOD=ariel
TOP_K=3
CHUNK_TYPE=paragraph
CHUNK_MAX_TOKENS=256

# Set RUN_SUMMARIZE=1 only when you want this script to generate summaries.
RUN_SUMMARIZE=0
RUN_CORRECTION=1
RUN_AFTER_VERIFY=1
RUN_CASE_EXPORT=1

HF_LOCAL_FILES_ONLY=0
TRUST_REMOTE_CODE=0

SUMMARY_MODEL=Qwen/Qwen2.5-1.5B-Instruct
SUMMARY_DEVICE=auto
SUMMARY_DTYPE=auto
SUMMARY_TARGET_WORDS=240
SUMMARY_CHUNK_INPUT_TOKENS=6000
SUMMARY_CHUNK_OVERLAP_TOKENS=256
SUMMARY_CHUNK_MAX_NEW_TOKENS=256
SUMMARY_FINAL_MAX_NEW_TOKENS=384

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_LOCAL_FILES_ONLY=0

NLI_MODEL=facebook/bart-large-mnli
NLI_DEVICE=cpu
NLI_MAX_LENGTH=1024
NLI_AGGREGATION=per_chunk
NLI_ENTAILMENT_THRESHOLD=0.5
NLI_CONTRADICTION_THRESHOLD=0.5
NLI_LOCAL_FILES_ONLY=0

CORRECTION_MODEL=Qwen/Qwen2.5-1.5B-Instruct
CORRECTION_DEVICE=auto
CORRECTION_DTYPE=auto
CORRECTION_LOCAL_FILES_ONLY=0
CORRECTION_MAX_PROMPT_TOKENS=4096
CORRECTION_MAX_NEW_TOKENS=128
CORRECTION_NEUTRAL_REWRITE_THRESHOLD=0.7
CORRECTION_MAX_EVIDENCE_SENTENCES=5
CORRECTION_FALLBACK_ACTION=keep
CORRECTION_CONTINUE_ON_ERROR=1
