# Small local debug configuration using the five prepared GovReport samples.
# It avoids correction by default so the debug run does not need to load Qwen.

PYTHON=.venv/bin/python
RUN_NAME=debug_pipeline
RUN_DIR=data/results/debug_pipeline

DOCUMENTS=data/processed/documents_debug_5.jsonl
SUMMARIES=data/processed/summaries_debug_5.jsonl
SUMMARY_FIELD=clean_summary

RETRIEVAL_METHOD=ariel
TOP_K=3
CHUNK_TYPE=paragraph
CHUNK_MAX_TOKENS=256

RUN_SUMMARIZE=0
RUN_CORRECTION=0
RUN_AFTER_VERIFY=0
RUN_CASE_EXPORT=1

HF_LOCAL_FILES_ONLY=1
EMBEDDING_LOCAL_FILES_ONLY=1
NLI_LOCAL_FILES_ONLY=1

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

NLI_MODEL=facebook/bart-large-mnli
NLI_DEVICE=cpu
NLI_MAX_LENGTH=1024
NLI_AGGREGATION=per_chunk
NLI_ENTAILMENT_THRESHOLD=0.5
NLI_CONTRADICTION_THRESHOLD=0.5

