# Controlled summary-length experiment configuration for GPU runs.
# This experiment uses the same 100 GovReport documents and generates short,
# medium, and long summaries before ARIEL + NLI verification.

PYTHON=.venv/bin/python
CONTROLLED_RUN_NAME=controlled_length_100_wide_gpu
RUN_ROOT=data/results/controlled_length_100_wide_gpu

SOURCE_DOCUMENTS=data/processed/documents_main_600.jsonl
DOCUMENTS=data/processed/documents_controlled_length_100.jsonl
CONTROLLED_LIMIT=100

# Format: label:target_words:chunk_max_new_tokens:final_max_new_tokens
# Medium uses the same nominal target length as the main 600-experiment setup.
# In the main setting, target_words=240 produced an actual average length of
# about 193.5 words.
# Short and long are deliberately widened to make the controlled length
# contrast clearer than the initial 120/240/360 run.
LENGTH_SPECS="short:80:128:160 medium:240:256:384 long:520:640:900"
SUMMARY_TARGET_WORD_TOLERANCE=0.15

TOP_K=3
CHUNK_TYPE=paragraph
CHUNK_MAX_TOKENS=256
HYBRID_ALPHA=0.5

HF_LOCAL_FILES_ONLY=0
TRUST_REMOTE_CODE=0

SUMMARY_MODEL=Qwen/Qwen2.5-1.5B-Instruct
SUMMARY_DEVICE=cuda
SUMMARY_DTYPE=auto
SUMMARY_CHUNK_INPUT_TOKENS=6000
SUMMARY_CHUNK_OVERLAP_TOKENS=256

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cuda
EMBEDDING_LOCAL_FILES_ONLY=0

NLI_MODEL=facebook/bart-large-mnli
NLI_DEVICE=cuda
NLI_MAX_LENGTH=1024
NLI_AGGREGATION=per_chunk
NLI_ENTAILMENT_THRESHOLD=0.5
NLI_CONTRADICTION_THRESHOLD=0.5
NLI_LOCAL_FILES_ONLY=0

OUTPUT_DIR=outputs/tables/controlled_length_100_wide_gpu
